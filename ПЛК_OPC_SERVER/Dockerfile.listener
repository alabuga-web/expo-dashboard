FROM python:3.12-slim

WORKDIR /app

COPY requirements-backend.txt .
RUN pip install --no-cache-dir -r requirements-backend.txt

COPY shared/ shared/
COPY opc_listener/ opc_listener/
COPY config/ config/
COPY *.xml .

ENV PYTHONPATH=/app

CMD ["python", "-m", "opc_listener.main", "--config", "config/servers.yaml"]
