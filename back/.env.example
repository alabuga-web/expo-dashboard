# Скопируй в .env.dev или .env.prod и подправь при необходимости:
#   cp .env.example .env.dev

PLC_MODE=dev
COMPOSE_PROFILES=dev
LISTENER_SERVERS=simulator

UI_PORT=8000
OPC_SIMULATOR_PORT=4840
PLC_OPC_ENDPOINT=opc.tcp://192.168.0.1:4840
KAFKA_EXTERNAL_PORT=19092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=plc.tag.events
POLL_INTERVAL_SEC=1.0
DATABASE_PATH=/data/plc_data.db
OPC_NODESET=Выставка демо.PLC_2.OPCUA.xml
